  "main": "pkg/bx_distance_models.js",
  "types": "pkg/bx_distance_models.d.ts",
  "files": [
    "pkg/bx_distance_models_bg.wasm",
    "pkg/bx_distance_models.js",
    "pkg/bx_distance_models.d.ts",
    "pkg/bx_distance_models_bg.wasm.d.ts"
  ]
}
